generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Faculty {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  departments Department[]
  createdAt   DateTime     @default(now())
}

model Department {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  facultyId Int
  faculty   Faculty   @relation(fields: [facultyId], references: [id])
  courses   Course[]
  students  Student[]
  createdAt DateTime  @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  lecturer  Lecturer?
  student   Student?
}

enum Role {
  ADMIN
  LECTURER
  STUDENT
}

model Lecturer {
  id           Int         @id @default(autoincrement())
  staffId      String      @unique
  firstName    String
  lastName     String
  userId       Int         @unique
  user         User        @relation(fields: [userId], references: [id])
  courses      Course[]
  timetables   Timetable[]
  createdAt    DateTime    @default(now())
}

model Student {
  id           Int        @id @default(autoincrement())
  matricNumber String     @unique
  firstName    String
  lastName     String
  level        Int
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  userId       Int        @unique
  user         User       @relation(fields: [userId], references: [id])
  createdAt    DateTime   @default(now())
}

model Course {
  id           Int         @id @default(autoincrement())
  code         String      @unique
  title        String
  unitLoad     Int
  level        Int
  departmentId Int
  department   Department  @relation(fields: [departmentId], references: [id])
  lecturerId   Int
  lecturer     Lecturer    @relation(fields: [lecturerId], references: [id])
  timetables   Timetable[]
  createdAt    DateTime    @default(now())
}

model Room {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  capacity   Int
  type       RoomType    @default(PHYSICAL)
  building   String?
  timetables Timetable[]
  createdAt  DateTime    @default(now())
}

enum RoomType {
  PHYSICAL
  VIRTUAL
}

model Timeslot {
  id         Int         @id @default(autoincrement())
  day        String
  startTime  String
  endTime    String
  timetables Timetable[]
  createdAt  DateTime    @default(now())
}

model Timetable {
  id         Int      @id @default(autoincrement())
  courseId   Int
  course     Course   @relation(fields: [courseId], references: [id])
  lecturerId Int
  lecturer   Lecturer @relation(fields: [lecturerId], references: [id])
  roomId     Int
  room       Room     @relation(fields: [roomId], references: [id])
  timeslotId Int
  timeslot   Timeslot @relation(fields: [timeslotId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([lecturerId, timeslotId])
  @@unique([roomId, timeslotId])
}